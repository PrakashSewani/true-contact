{
  "name": "true-contact",
  "version": "1.3.0",
  "private": true,
  "description": "TrueContact — a personal source of truth for your contacts. Product, WhatsApp connector extension, and promo site in one repo.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev:product": "pnpm --filter @truecontact/product run dev",
    "dev:product:web": "pnpm --filter @truecontact/product run dev:web",
    "dev:extension": "pnpm --filter @truecontact/extension run dev",
    "dev:site": "pnpm --filter @truecontact/site run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  }
}
