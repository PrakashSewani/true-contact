{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "true-contact",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "app.truecontact.prakashsewani.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "FREE_IMPORT_LIMIT": "1000",
    "IMPORT_CHUNK_SIZE": "5"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truecontact",
      "database_id": "c796f06b-8639-47f4-8437-32bf09f1105a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMPORTS_BUCKET",
      "bucket_name": "truecontact-imports"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMPORTS_QUEUE",
        "queue": "truecontact-imports"
      }
    ],
    "consumers": [
      {
        "queue": "truecontact-imports",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
