---
import { BRAND } from '@truecontact/shared';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{BRAND.name}</title>
    <meta name="description" content={BRAND.tagline} />
  </head>
  <body>
    <main>
      <h1>{BRAND.name}</h1>
      <p class="tagline">{BRAND.tagline}</p>
      <p class="note">
        Your contacts are scattered across phones, WhatsApp, and old exports — and they disagree
        with each other. TrueContact builds one reviewable, canonical contact book and keeps the
        history of how it changed. The product is in development; this page is a placeholder
        until the promo site phase.
      </p>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  main {
    max-width: 38rem;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
  }

  .tagline {
    font-size: 1.25rem;
    margin: 0 0 1.5rem;
    opacity: 0.85;
  }

  .note {
    opacity: 0.7;
  }
</style>
